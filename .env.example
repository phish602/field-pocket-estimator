# Placeholder-only environment variables for future approved runtime setup.
# Do not put real secrets in this file.
# Service-role keys, database passwords, database connection strings, JWT secrets,
# access tokens, refresh tokens, private keys, and admin keys are forbidden here.
# Real local values belong only in an uncommitted local env file after a future approval gate.
# Runtime wiring remains blocked.

REACT_APP_SUPABASE_URL=replace_with_supabase_project_url
REACT_APP_SUPABASE_ANON_KEY=replace_with_supabase_anon_public_key

# Emergency Gate P1 -- fail-closed cloud opt-in.
# The browser Supabase client is constructed ONLY when this flag is exactly
# "true" AND the deployment is a Vercel Production build. It is the explicit,
# per-environment opt-in that keeps Preview/local/test/unknown builds from ever
# reaching the hosted Supabase project (see src/lib/supabaseRuntimePolicy.js).
#   - Keep it false/unset locally.
#   - Keep it false/unset in Vercel Preview.
#   - Keep it false/unset in Vercel Development.
#   - Only the Vercel Production environment may set it to true.
REACT_APP_ESTIPAID_CLOUD_ENABLED=false

# ISO-10 -- fail-closed LOCAL Supabase opt-in (Docker/Supabase CLI stack).
# A separate lane from the cloud opt-in above. When this flag is exactly "true"
# the browser client may be constructed ONLY if ALL of the following hold:
#   - REACT_APP_SUPABASE_URL is exactly one of the supported loopback origins:
#       http://127.0.0.1:54321   http://127.0.0.1:54321/
#       http://localhost:54321   http://localhost:54321/
#     (plain http, loopback host, explicit port 54321, root path, and no
#      credentials, query string, or fragment)
#   - REACT_APP_ESTIPAID_CLOUD_ENABLED is NOT true
#   - REACT_APP_VERCEL_ENV and REACT_APP_VERCEL_TARGET_ENV are BOTH unset
# Setting both this flag and REACT_APP_ESTIPAID_CLOUD_ENABLED to true is a
# configuration error and is always denied (reason: conflicting_opt_ins).
# Keep it false here and false/unset in every Vercel environment.
REACT_APP_ESTIPAID_LOCAL_SUPABASE_ENABLED=false

# Temporary phone testing through Cloudflare Quick Tunnels (DEVELOPMENT ONLY).
# Disabled by default. Never set these in Production, Preview, or hosted
# environments. The Supabase tunnel URL changes every time that Quick Tunnel is
# restarted, so restart the React dev server with the new value each time.
# Normal localhost access continues to use REACT_APP_SUPABASE_URL directly.
REACT_APP_ESTIPAID_MOBILE_TEST_MODE=false
# REACT_APP_MOBILE_TEST_SUPABASE_URL=https://<temporary>.trycloudflare.com

# Enabling local Supabase (only when intentionally running the local stack):
# put the real values in an UNCOMMITTED .env.development.local -- never here,
# and never in a committed file. Example shape only, values are placeholders:
#   REACT_APP_SUPABASE_URL=http://127.0.0.1:54321
#   REACT_APP_SUPABASE_ANON_KEY=<local anon key printed by `supabase start`>
#   REACT_APP_ESTIPAID_LOCAL_SUPABASE_ENABLED=true
#
# Rules for that file:
#   - Local mode accepts loopback port 54321 ONLY. Any other host, port,
#     protocol, path, query, fragment, or credential is denied
#     (reason: invalid_local_supabase_url).
#   - Hosted Supabase is NEVER reachable through the local lane. It still
#     requires the existing Production cloud lane
#     (Vercel Production + REACT_APP_ESTIPAID_CLOUD_ENABLED=true).
#   - Vercel Preview and Vercel Development remain denied no matter what the
#     local flag or URL say.
#   - NEVER set or spoof REACT_APP_VERCEL_ENV / REACT_APP_VERCEL_TARGET_ENV
#     locally; any value in either one disables the local lane entirely.
#   - Only the local ANON/publishable key belongs in REACT_APP_*. Service-role
#     keys, the JWT secret, and DB passwords must NEVER appear in a REACT_APP_*
#     variable -- those are compiled into the browser bundle.

# Supplied automatically by Vercel at build time; do NOT set or spoof these
# locally. The runtime policy reads them to confirm a Production deployment.
# REACT_APP_VERCEL_ENV is one of: production | preview | development.
# REACT_APP_VERCEL_TARGET_ENV, when present, must also be "production".
# (Left commented out on purpose -- Vercel injects the real values.)
# REACT_APP_VERCEL_ENV=
# REACT_APP_VERCEL_TARGET_ENV=
